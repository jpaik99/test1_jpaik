  :root{
    --navy: #16283F;
    --navy-deep: #0E1C2E;
    --navy-light: #274361;
    --beige: #F3ECDF;
    --beige-soft: #FAF6EE;
    --beige-dark: #E4D6BA;
    --gold: #C6A15B;
    --gold-light: #E2C68C;
    --gold-deep: #9C7B3B;
    --ink: #1E2530;
    --ink-soft: #4B5563;
    --line: rgba(198,161,91,0.28);
    --serif: 'Noto Serif KR', serif;
    --sans: 'Pretendard Variable', Pretendard, -apple-system, BlinkMacSystemFont, sans-serif;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    font-family: var(--sans);
    color: var(--ink);
    background: var(--beige-soft);
    line-height:1.6;
    overflow-x:hidden;
  }
  a{text-decoration:none;color:inherit;}
  ul{list-style:none;}
  img{max-width:100%;display:block;}
  section{position:relative;}
  .eyebrow{
    display:inline-flex;align-items:center;gap:10px;
    font-family:var(--sans); font-weight:600; font-size:13px;
    letter-spacing:0.28em; text-transform:uppercase;
    color: var(--gold-deep);
    margin-bottom:18px;
  }
  .eyebrow::before{
    content:"";width:28px;height:1px;background:var(--gold);
  }
  .section-inner{
    max-width:1120px; margin:0 auto; padding:120px 32px;
  }
  h1,h2,h3,h4{font-family:var(--serif); font-weight:700; color:var(--navy);}
  .light-heading{color:var(--beige-soft);}
  .btn{
    display:inline-flex; align-items:center; gap:10px;
    padding:15px 32px; border:1px solid var(--gold);
    color:var(--navy); font-weight:600; font-size:14px;
    letter-spacing:0.04em; background:transparent;
    transition:all .35s ease; cursor:pointer;
    font-family:var(--sans);
  }
  .btn:hover{ background:var(--gold); color:var(--navy-deep); }
  .btn.solid{ background:var(--gold); color:var(--navy-deep); }
  .btn.solid:hover{ background:var(--gold-light); border-color:var(--gold-light);}
  .btn.on-dark{ border-color:var(--gold); color:var(--beige-soft); }
  .btn.on-dark:hover{ background:var(--gold); color:var(--navy-deep); }

  /* ===== NAV ===== */
  header{
    position:fixed; top:0; left:0; right:0; z-index:100;
    display:flex; align-items:center; justify-content:space-between;
    padding: 22px 44px;
    transition: all .4s ease;
    background: transparent;
  }
  header.scrolled{
    background: rgba(14,28,46,0.94);
    backdrop-filter: blur(6px);
    padding: 14px 44px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.18);
  }
  .logo{
    font-family:var(--serif); font-weight:700; font-size:22px;
    color: var(--beige-soft); letter-spacing:0.02em;
    display:flex; flex-direction:column; line-height:1.1;
  }
  .logo span{
    font-family:var(--sans); font-weight:500; font-size:10px;
    letter-spacing:0.32em; color: var(--gold-light); margin-top:4px;
  }
  nav ul{ display:flex; gap:44px; }
  nav a{
    font-size:14px; font-weight:600; color: var(--beige-soft);
    letter-spacing:0.03em; position:relative; padding-bottom:4px;
  }
  nav a::after{
    content:""; position:absolute; left:0; bottom:0; width:0; height:1px;
    background:var(--gold); transition:width .3s ease;
  }
  nav a:hover::after, nav a.active::after{ width:100%; }
  .nav-cta{ display:flex; align-items:center; gap:24px; }
  .nav-tel{ color:var(--gold-light); font-size:13px; font-weight:600; letter-spacing:0.02em; display:none; }
  .burger{ display:none; flex-direction:column; gap:5px; cursor:pointer; z-index:120; }
  .burger span{ width:24px; height:2px; background:var(--beige-soft); }

  /* ===== HERO ===== */
  #home{
    height:100vh; min-height:680px;
    display:flex; align-items:center; justify-content:center;
    background: linear-gradient(180deg, var(--navy-deep) 0%, var(--navy) 62%, var(--navy-light) 100%);
    overflow:hidden;
  }
  .hero-skyline{
    position:absolute; bottom:0; left:0; width:100%; opacity:0.9;
  }
  .hero-glow{
    position:absolute; top:-10%; left:50%; transform:translateX(-50%);
    width:900px; height:900px; border-radius:50%;
    background: radial-gradient(circle, rgba(198,161,91,0.16) 0%, rgba(198,161,91,0) 70%);
    pointer-events:none;
  }
  .hero-content{
    position:relative; z-index:5; text-align:center; padding: 0 24px;
    max-width:820px;
  }
  .hero-eyebrow{
    color:var(--gold-light); font-size:13px; letter-spacing:0.36em;
    text-transform:uppercase; font-weight:600; margin-bottom:28px;
    display:flex; align-items:center; justify-content:center; gap:14px;
    opacity:0; animation: fadeUp .9s ease .2s forwards;
  }
  .hero-eyebrow::before, .hero-eyebrow::after{ content:""; width:36px; height:1px; background:var(--gold); }
  .hero-slogan{
    font-family:var(--serif); font-weight:900; color:var(--beige-soft);
    font-size: clamp(34px, 5.4vw, 62px); line-height:1.32;
    letter-spacing:-0.01em;
    opacity:0; animation: fadeUp 1s ease .4s forwards;
  }
  .hero-slogan em{ font-style:normal; color:var(--gold-light); }
  .hero-sub{
    margin-top:26px; color:rgba(243,236,223,0.78); font-size:16px;
    font-weight:400; letter-spacing:0.01em; line-height:1.8;
    opacity:0; animation: fadeUp 1s ease .6s forwards;
  }
  .hero-btns{
    margin-top:44px; display:flex; gap:16px; justify-content:center;
    opacity:0; animation: fadeUp 1s ease .8s forwards;
  }
  @keyframes fadeUp{ from{opacity:0; transform:translateY(18px);} to{opacity:1; transform:translateY(0);} }
  .scroll-cue{
    position:absolute; bottom:34px; left:50%; transform:translateX(-50%);
    display:flex; flex-direction:column; align-items:center; gap:10px;
    color:rgba(243,236,223,0.6); font-size:11px; letter-spacing:0.24em;
    z-index:5;
  }
  .scroll-cue .line{ width:1px; height:40px; background:linear-gradient(var(--gold), transparent); animation: scrollLine 2s ease-in-out infinite; }
  @keyframes scrollLine{ 0%{transform:scaleY(0); transform-origin:top;} 50%{transform:scaleY(1); transform-origin:top;} 51%{transform-origin:bottom;} 100%{transform:scaleY(0); transform-origin:bottom;} }

  /* Home: differentiation preview under hero */
  .home-diff{ background: var(--beige-soft); }

  /* Company intro strip under hero */
  .intro-strip{
    background:var(--beige-soft);
    padding: 100px 32px 60px;
  }
  .intro-grid{
    max-width:1120px; margin:0 auto;
    display:grid; grid-template-columns: 0.9fr 1.1fr; gap:70px; align-items:start;
  }
  .intro-grid h2{ font-size: clamp(26px,3vw,36px); line-height:1.5; }
  .intro-grid .body-text{ color:var(--ink-soft); font-size:15.5px; line-height:2; }
  .intro-stats{ display:grid; grid-template-columns: repeat(3,1fr); gap:0; margin-top:44px; border-top:1px solid var(--line); }
  .intro-stats div{ padding:24px 18px 0; border-right:1px solid var(--line); }
  .intro-stats div:last-child{ border-right:none; }
  .intro-stats .num{ font-family:var(--serif); font-weight:700; font-size:30px; color:var(--gold-deep); }
  .intro-stats .lbl{ font-size:12.5px; color:var(--ink-soft); margin-top:6px; letter-spacing:0.02em; }

  /* ===== SECTION HEADERS ===== */
  .sec-head{ max-width:640px; margin-bottom:64px; }
  .sec-head.center{ margin-left:auto; margin-right:auto; text-align:center; }
  .sec-head h2{ font-size: clamp(28px,3.4vw,40px); line-height:1.4; }
  .sec-head p{ margin-top:18px; color:var(--ink-soft); font-size:15.5px; }

  /* ===== COMPANY ===== */
  #company{ background: var(--beige); }
  .greeting-wrap{
    display:grid; grid-template-columns: 300px 1fr; gap:64px; align-items:start;
    padding-bottom:96px; border-bottom:1px solid var(--line);
  }
  .greeting-portrait{
    aspect-ratio: 3/4; background: linear-gradient(160deg, var(--navy) 0%, var(--navy-deep) 100%);
    position:relative; overflow:hidden;
    display:flex; align-items:flex-end; padding:22px;
  }
  .greeting-portrait svg{ position:absolute; inset:0; width:100%; height:100%; opacity:0.9; }
  .greeting-portrait .tag{ position:relative; z-index:2; color:var(--gold-light); font-size:12px; letter-spacing:0.18em; }
  .greeting-quote{ font-family:var(--serif); font-size:22px; line-height:1.7; color:var(--navy); font-weight:600; margin-bottom:26px; }
  .greeting-body{ color:var(--ink-soft); font-size:15px; line-height:2; }
  .greeting-sign{ margin-top:30px; font-family:var(--serif); font-weight:700; color:var(--navy); font-size:16px; }
  .greeting-sign span{ display:block; font-family:var(--sans); font-weight:400; font-size:12.5px; color:var(--ink-soft); margin-top:4px; letter-spacing:0.04em; }

  .vision-wrap{ padding: 96px 0; border-bottom:1px solid var(--line); }
  .vision-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:36px; margin-top:52px; }
  .vision-card{ background:var(--beige-soft); padding:38px 30px; border-top:2px solid var(--gold); }
  .vision-card .vn{ font-family:var(--serif); font-size:13px; color:var(--gold-deep); font-weight:700; letter-spacing:0.1em; }
  .vision-card h3{ font-size:19px; margin:14px 0 12px; }
  .vision-card p{ color:var(--ink-soft); font-size:14px; line-height:1.85; }

  /* differentiation - Before/After compare cards */
  .diff-wrap{ padding-top:96px; }
  .diff-compare{
    display:grid; grid-template-columns: 1fr 84px 1fr; align-items:stretch;
    margin-top:56px; gap:0;
  }
  .diff-card{
    background:var(--beige-soft); border:1px solid var(--line);
    display:flex; flex-direction:column;
  }
  .diff-card .dc-media{ position:relative; aspect-ratio: 3/1.5; overflow:hidden; }
  .diff-card .dc-media svg{ width:100%; height:100%; display:block; }
  .diff-card .dc-media::after{
    content:""; position:absolute; inset:0;
    background: linear-gradient(180deg, rgba(14,28,46,0) 38%, rgba(14,28,46,0.88) 100%);
  }
  .diff-card .dc-label{ position:absolute; left:28px; bottom:24px; z-index:2; }
  .diff-card .dc-label .bar{ width:44px; height:3px; background:var(--gold); margin-bottom:12px; }
  .diff-card .dc-label h4{ font-family:var(--serif); color:#fff; font-size:22px; font-weight:700; }
  .diff-card .dc-label p{ color:rgba(255,255,255,0.82); font-size:13px; margin-top:6px; letter-spacing:0.01em; }

  .diff-card .dc-body{ flex:1; display:flex; flex-direction:column; }
  .dc-item{ display:flex; gap:16px; align-items:flex-start; padding:22px 28px; border-bottom:1px solid var(--line); }
  .dc-item:last-child{ border-bottom:none; }
  .dc-icon{
    width:38px; height:38px; flex-shrink:0; border-radius:50%;
    display:flex; align-items:center; justify-content:center;
  }
  .dc-icon svg{ width:19px; height:19px; }
  .diff-card.before .dc-icon{ background: rgba(75,85,99,0.1); }
  .diff-card.before .dc-icon svg{ stroke:#6B7684; }
  .diff-card.after .dc-icon{ background: rgba(198,161,91,0.16); }
  .diff-card.after .dc-icon svg{ stroke:var(--gold-deep); }
  .dc-item p{ font-size:14.5px; color:var(--ink-soft); line-height:1.65; padding-top:6px; }
  .dc-item p strong{ display:block; font-size:15px; font-weight:700; color:var(--navy); margin-top:2px; }
  .diff-card.after .dc-item p strong{ color:var(--gold-deep); }
  .diff-card.after .dc-body{ background: rgba(198,161,91,0.05); }

  .diff-arrow{ display:flex; align-items:center; justify-content:center; }
  .diff-arrow svg{ width:52px; height:34px; }

  /* ===== SERVICE ===== */
  #service{ background: var(--beige-soft); }
  .service-grid{ display:grid; grid-template-columns: repeat(2,1fr); gap:2px; background:var(--line); margin-top:20px; }
  .service-card{
    background:var(--beige-soft); padding:52px 46px; position:relative;
    transition: background .35s ease;
  }
  .service-card:hover{ background: var(--beige); }
  .service-index{ font-family:var(--serif); font-size:14px; color:var(--gold-deep); font-weight:700; letter-spacing:0.08em; margin-bottom:20px; display:block; }
  .service-card h3{ font-size:23px; margin-bottom:14px; }
  .service-card .desc{ color:var(--ink-soft); font-size:14.5px; line-height:1.9; margin-bottom:26px; }
  .service-placeholder{
    border:1px dashed var(--gold); padding:16px 18px; font-size:12.5px;
    color:var(--gold-deep); letter-spacing:0.02em; display:flex; align-items:center; gap:10px;
    background: rgba(198,161,91,0.05);
  }
  .service-placeholder svg{ width:16px; height:16px; flex-shrink:0; }

  /* ===== PORTFOLIO ===== */
  #portfolio{ background: var(--navy-deep); }
  #portfolio .eyebrow{ color:var(--gold-light); }
  #portfolio .eyebrow::before{ background:var(--gold-light); }
  #portfolio .sec-head h2{ color:var(--beige-soft); }
  #portfolio .sec-head p{ color: rgba(243,236,223,0.66); }
  .portfolio-grid{ display:grid; grid-template-columns: 1.3fr 1fr; gap:2px; margin-top:20px; }
  .portfolio-feature{
    background: var(--navy); padding:0; position:relative; overflow:hidden;
    min-height:420px; display:flex; flex-direction:column; justify-content:flex-end;
  }
  .portfolio-feature .pf-art{ position:absolute; inset:0; }
  .portfolio-feature .pf-body{ position:relative; z-index:2; padding:40px; background:linear-gradient(0deg, rgba(14,28,46,0.96) 10%, rgba(14,28,46,0.2) 100%); }
  .pf-tag{ font-size:12px; letter-spacing:0.2em; color:var(--gold-light); text-transform:uppercase; margin-bottom:14px; }
  .pf-body h3{ color:var(--beige-soft); font-size:28px; margin-bottom:12px; }
  .pf-body p{ color:rgba(243,236,223,0.72); font-size:14px; line-height:1.8; max-width:440px; }
  .portfolio-empty{
    display:flex; flex-direction:column; gap:2px;
  }
  .pf-slot{
    flex:1; background: var(--navy); border:1px dashed rgba(198,161,91,0.35);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center; padding:30px; min-height:206px;
  }
  .pf-slot svg{ width:30px; height:30px; margin-bottom:14px; opacity:0.6; }
  .pf-slot span{ color:rgba(243,236,223,0.5); font-size:12.5px; letter-spacing:0.05em; }

  /* ===== CONTACT ===== */
  #contact{ background: var(--beige); }
  .contact-grid{ display:grid; grid-template-columns: 1fr 1.15fr; gap:70px; margin-top:20px; }
  .contact-info-list{ display:flex; flex-direction:column; gap:0; }
  .contact-item{ display:flex; gap:22px; padding:28px 0; border-bottom:1px solid var(--line); }
  .contact-item:first-child{ padding-top:0; }
  .contact-icon{
    width:46px; height:46px; border:1px solid var(--gold); flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
  }
  .contact-icon svg{ width:20px; height:20px; stroke:var(--gold-deep); }
  .contact-item h4{ font-size:13px; letter-spacing:0.1em; color:var(--gold-deep); font-weight:700; margin-bottom:8px; text-transform:uppercase; }
  .contact-item p{ font-size:16px; color:var(--navy); font-weight:500; line-height:1.6; }
  .contact-item p.small{ font-size:13.5px; color:var(--ink-soft); font-weight:400; margin-top:4px; }

  .map-box{ background:var(--beige-soft); border:1px solid var(--line); padding:28px; }
  .map-box .map-label{ font-size:13px; letter-spacing:0.08em; color:var(--gold-deep); font-weight:700; margin-bottom:16px; }
  .map-box svg{ width:100%; height:auto; }
  .map-note{ margin-top:16px; font-size:12.5px; color:var(--ink-soft); line-height:1.7; }

  /* ===== FOOTER ===== */
  footer{ background:var(--navy-deep); padding:70px 32px 34px; }
  .footer-inner{ max-width:1120px; margin:0 auto; }
  .footer-top{ display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:30px; padding-bottom:40px; border-bottom:1px solid rgba(198,161,91,0.2); }
  .footer-logo{ font-family:var(--serif); font-size:24px; color:var(--beige-soft); font-weight:700; }
  .footer-slogan{ color:var(--gold-light); font-size:14px; margin-top:10px; letter-spacing:0.03em; }
  .footer-nav{ display:flex; gap:34px; }
  .footer-nav a{ color:rgba(243,236,223,0.7); font-size:13.5px; font-weight:500; }
  .footer-bottom{ display:flex; justify-content:space-between; padding-top:26px; color:rgba(243,236,223,0.4); font-size:12px; flex-wrap:wrap; gap:10px; }

  /* ===== RESPONSIVE ===== */
  @media (min-width: 861px){ .nav-tel{ display:block; } }
  @media (max-width: 860px){
    nav{ position:fixed; top:0; right:-100%; width:78%; max-width:340px; height:100vh;
      background:var(--navy-deep); flex-direction:column; padding:110px 40px; transition:right .4s ease; z-index:110; }
    nav.open{ right:0; }
    nav ul{ flex-direction:column; gap:30px; }
    .burger{ display:flex; }
    .intro-grid, .greeting-wrap, .contact-grid{ grid-template-columns:1fr; }
    .vision-grid, .service-grid{ grid-template-columns:1fr; }
    .portfolio-grid{ grid-template-columns:1fr; }
    .portfolio-empty{ flex-direction:row; }
    .diff-compare{ grid-template-columns:1fr; }
    .diff-arrow{ padding:18px 0; }
    .diff-arrow svg{ transform:rotate(90deg); }
    .section-inner{ padding:90px 22px; }
    header{ padding:18px 22px; }
  }

/* ===== SUBPAGE BANNER (Company/Service/Portfolio/Contact) ===== */
.page-banner{
  background: linear-gradient(180deg, var(--navy-deep) 0%, var(--navy) 100%);
  padding: 200px 44px 76px;
  position:relative; overflow:hidden;
}
.page-banner-inner{ max-width:1120px; margin:0 auto; position:relative; z-index:2; }
.page-banner .crumb{
  display:flex; align-items:center; gap:8px;
  color: rgba(243,236,223,0.5); font-size:12.5px; letter-spacing:0.04em; margin-bottom:20px;
}
.page-banner .crumb a{ color: var(--gold-light); }
.page-banner .crumb svg{ width:11px; height:11px; opacity:0.55; }
.page-banner .eyebrow{ color: var(--gold-light); margin-bottom:16px; }
.page-banner .eyebrow::before{ background: var(--gold-light); }
.page-banner h1{
  font-family:var(--serif); color:#fff; font-weight:800;
  font-size: clamp(30px,4vw,46px); line-height:1.3;
}
.page-banner p{ margin-top:16px; color:rgba(243,236,223,0.72); font-size:15px; max-width:520px; line-height:1.8; }

/* section-inner variant with less top padding, used right after page-banner */
.section-inner.tight{ padding-top:90px; }

@media (max-width: 860px){
  .page-banner{ padding:150px 22px 54px; }
  .section-inner.tight{ padding-top:70px; }
}

